# ==============================================================================
# K D Engineering Solutions (kdes.in) - Cybersecurity & Anti-Cloning Rules
# ISO 27001 & OWASP Compliant Configuration for Apache / LiteSpeed Web Servers
# ==============================================================================

# 1. Disable Directory Listing & File Indexing
Options -Indexes -MultiViews

# 2. Block Access to Hidden & Sensitive Files
<FilesMatch "(^\.|\.(json|log|md|lock|yml|yaml|ini|env|sql|sh|bak|swp)$|inquiries_backup\.json|package\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. HTTP Security Headers
<IfModule mod_headers.c>
    # Prevent Clickjacking & unauthorized iframe embedding
    Header always set X-Frame-Options "SAMEORIGIN"

    # Prevent MIME Sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Enable browser XSS filtering
    Header always set X-XSS-Protection "1; mode=block"

    # Protect referral leakage while retaining origin for security validation
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Restrict unnecessary browser APIs and hardware capabilities
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), display-capture=()"

    # Cross-Origin Opener Policy to prevent XS-leaks & window references
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"

    # Cross-Origin Resource Policy
    Header always set Cross-Origin-Resource-Policy "same-origin"

    # Strict Content Security Policy (Allows Google Maps, Fonts, and FontAwesome icons)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; connect-src 'self'; frame-src 'self' https://www.google.com https://maps.google.com; object-src 'none'; base-uri 'self'; form-action 'self' sendmail.php; frame-ancestors 'self';"

    # Enforce HTTPS Strict Transport Security (HSTS)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# 4. Anti-Cloning & Scraper Shield (Block Automated Website Copiers)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block known mass scrapers and offline website downloaders
    RewriteCond %{HTTP_USER_AGENT} (HTTrack|Wget|Scrapy|WebCopier|Teleport|Offline\ Explorer|EmailCollector|libwww-perl|Python-urllib|Go-http-client|SiteSnagger|WebZip|WebReaper|WebSauger|SuperBot|Mirror|Website\ Copier|BlackWidow|Grafula) [NC]
    RewriteRule .* - [F,L]

    # Anti-Hotlinking: Prevent third-party sites from embedding KDES product media
    RewriteCond %{HTTP_REFERER} !^$
    RewriteCond %{HTTP_REFERER} !^https?://(www\.)?kdes\.in [NC]
    RewriteCond %{HTTP_REFERER} !^https?://localhost [NC]
    RewriteCond %{HTTP_REFERER} !^https?://127\.0\.0\.1 [NC]
    RewriteCond %{HTTP_REFERER} !^https?://(www\.)?google\. [NC]
    RewriteCond %{HTTP_REFERER} !^https?://(www\.)?bing\. [NC]
    RewriteRule \.(jpg|jpeg|png|gif|webp|svg|pdf)$ - [F,NC,L]
</IfModule>
